# Copy to .env and fill in. Never commit .env.

# Local development only: uncomment to add hot reload, Mailpit and exposed ports.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# --- Required -------------------------------------------------------------------
# Public hostname. Caddy obtains a Let's Encrypt certificate for it automatically.
# Use "localhost" for a local test (self-signed certificate).
DOMAIN=localhost
PUBLIC_BASE_URL=https://localhost
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# --- Admin panel (/admin) ------------------------------------------------------------
# CHANGE BOTH before exposing the server. Leave ADMIN_PASSWORD empty to disable /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Email notifications (leave SMTP_HOST empty to disable) ---------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="wpSBOOT <noreply@example.org>"

# --- Limits and lifecycle (defaults shown) ---------------------------------------------
# MAX_SEQUENCES=200
# MAX_SEQUENCE_LENGTH=10000
# MAX_UPLOAD_BYTES=2097152
# RATE_LIMIT_PER_HOUR=10
# MAX_ACTIVE_JOBS_PER_IP=2
# JOB_TIMEOUT_SECONDS=1800
# RETENTION_DAYS=14

# --- Capacity -----------------------------------------------------------------------------
# Each worker runs one job at a time (its aligners run in parallel).
WORKER_REPLICAS=2
WORKER_CPUS=2
WORKER_MEMORY=4g
BACKUP_KEEP=7
# LOG_LEVEL=INFO
